  "private": true,
  "dependencies": {
    "@codaworks/react-glow": "^1.0.6",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^13.5.0",
    "emailjs-com": "^3.2.0",
    "maath": "^0.10.8",
    "react": "^18.3.1",
    "react-awesome-slider": "^4.1.0",
    "react-dom": "^18.3.1",
    "react-icons": "^4.3.1",
    "react-router-dom": "^7.13.1",
    "react-scripts": "5.0.0",
    "styled-components": "^6.1.19",
    "swiper": "^8.0.6",
    "three": "^0.183.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "sync:linkedin": "node scripts/linkedin/sync-linkedin-profile.cjs",
    "sync:profile": "node scripts/sync-profile-content.cjs",
    "sync:profile:validate": "node -e \"require('./scripts/profile-utils.cjs').loadProfile(); console.log('Profile valid')\"",
    "set-headline": "node scripts/set-headline.cjs",
    "prestart": "npm run sync:linkedin && npm run sync:profile && node scripts/sync-movies-config.cjs",
    "prebuild": "npm run sync:linkedin && npm run sync:profile && node scripts/sync-movies-config.cjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -b master -d build",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test:profile": "node --test scripts/profile-model.test.cjs scripts/linkedin/map-linkedin-profile.test.cjs",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "gh-pages": "^4.0.0",
    "postcss": "^8.5.6"
  }
}
